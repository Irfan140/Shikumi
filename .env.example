# Shikumi — environment variables
# Copy to .env.development or .env and fill in values
# Bun auto-loads .env, .env.local, .env.development on startup

# BYOK: bring your own key — required for real LLM. If empty, MockProvider is used.
# For publish/distribution: DO NOT commit keys. End users run `shikumi setup` or set env/.shikumi/config.json
#
# Pick a provider (openai | groq). If unset, Shikumi uses the provider whose
# key is present (GROQ_API_KEY alone auto-selects groq).
# SHIKUMI_PROVIDER=openai

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Groq (https://console.groq.com/keys) — OpenAI-compatible API
# GROQ_API_KEY=gsk_...

# Model name (defaults: gpt-4o-mini for OpenAI, llama-3.3-70b-versatile for Groq)
SHIKUMI_MODEL=
# Provider-specific overrides (optional, used when that provider is active):
# OPENAI_MODEL=gpt-4o-mini
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: custom base URLs (Azure OpenAI, OpenRouter, local proxy, Groq EU, ...)
# OPENAI_BASE_URL=https://api.openai.com/v1
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Logging: fatal | error | warn | info | debug | trace (default: info)
LOG_LEVEL=info

# LangSmith tracing (optional — enables observability at smith.langchain.com)
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=Shikumi
# LANGCHAIN_TRACING_V2, LANGSMITH_PROJECT also supported for compat

# Node env: development | production | test
NODE_ENV=development
